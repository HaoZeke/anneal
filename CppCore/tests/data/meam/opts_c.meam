# Written for the rgpot MEAM tests, not taken from LAMMPS.
# Element order Ni AlS Cu Fe WL. ialloy 2 (t fixed to the element's own
# values), the mixed reference t of mixture_ref_t, the triangle pair and
# the ZBL blend at short range.
rc = 4.0
delr = 0.1
ialloy = 2
mixture_ref_t = 1
lattce(4,5) = 'tri'
theta(4,5) = 120.0
lattce(1,3) = 'b1'
zbl(1,3) = 1
Ec(1,5) = 4.1
re(1,5) = 2.55
alpha(1,5) = 4.9
