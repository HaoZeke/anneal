# Paper minima dumps, xyz dumps, and raw runs listed in data/hf-files.csv.
# Dataset: rgoswami/anneal-paper-data (repo type dataset).
# Not part of `rule all`. Scripts that read those files call the same
# program before they open them.
#   snakemake -s workflow/Snakefile fetch_paper_data
rule fetch_paper_data:
    output:
        "build/hf-fetch.ok",
    shell:
        """
        set -euo pipefail
        python3 scripts/data/fetch_data.py
        mkdir -p build
        : > build/hf-fetch.ok
        """


# GMIN's rigid-body TIP4P basin-hopping against anneal develop on the
# Cambridge sizes (H2O)8, 15, 20, 21 and, scored against the pooled best,
# (H2O)25. Twelve seeds, 2_000_000 charged evaluations, one serial session,
# sudo unshare --uts with hostname bench. Not part of `rule all`:
#   snakemake -s workflow/Snakefile tip4p_h2h
rule tip4p_h2h:
    output:
        "bench/tip4p-h2h/h2h-summary.csv",
    shell:
        """
        set -euo pipefail
        bash scripts/tip4p_h2h/enter_h2h.sh
        """


# (H2O)21 against GMIN on anneal develop's default preset across a budget
# sweep: 2M, 4M and 8M charged evaluations, twelve seeds, the same serial arm
# as tip4p_h2h. GMIN at a (budget, seed) pair is deterministic, so the rows
# the 2M head-to-head and the 4M/8M runs already stored are reused through
# H2H_GMIN_ROWS; GMIN only runs for pairs they are missing. Not part of
# `rule all`:
#   snakemake -s workflow/Snakefile tip4p21_budget_h2h
rule tip4p21_budget_h2h:
    output:
        "bench/tip4p-h2h/rows-budget21.csv",
        "bench/tip4p-h2h/summary-budget21.csv",
    shell:
        """
        set -euo pipefail
        bash scripts/tip4p_h2h/enter_budget.sh
        """


