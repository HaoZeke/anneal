# anneal, openconf and CREST iMTD-GC on drug-like molecules, MMFF94 for the
# two RDKit arms and GFN-FF for CREST. Not part of `rule all`. The budgets
# come from the openconf pilot (`enter_bench.sh pilot`):
#   snakemake -s workflow/Snakefile openconf_h2h
rule openconf_h2h:
    input:
        "bench/openconf-h2h/molecules.csv",
        "bench/openconf-h2h/budgets.csv",
    output:
        "bench/openconf-h2h/results.csv",
        "bench/openconf-h2h/seeds.csv",
    shell:
        """
        set -euo pipefail
        bash scripts/openconf_h2h/enter_bench.sh campaign
        OPENCONF_H2H_SKIP_BUILD=1 bash scripts/openconf_h2h/enter_bench.sh score
        """


# anneal against openconf alone, seeds 2000-2011, MMFF94 for both. anneal
# may make as many energy plus gradient calls as openconf made on the same
# seed. Rows are appended with code_revision and host. Not part of `rule all`:
#   snakemake -s workflow/Snakefile openconf_h2h_n12
rule openconf_h2h_n12:
    input:
        "bench/openconf-h2h/molecules.csv",
    output:
        "bench/openconf-h2h/paired/summary.csv",
        "bench/openconf-h2h/paired/stats.csv",
    shell:
        """
        set -euo pipefail
        OPENCONF_H2H_CREST=0 bash scripts/openconf_h2h/enter_bench.sh paired
        OPENCONF_H2H_SKIP_BUILD=1 bash scripts/openconf_h2h/enter_bench.sh paired-score
        """


# The paired n=12 run with a third arm, anneal at develop 92bc5805, at the
# same budget as the branch's anneal arm. Not part of `rule all`:
#   snakemake -s workflow/Snakefile openconf_h2h_conf_fix
rule openconf_h2h_conf_fix:
    input:
        "bench/openconf-h2h/molecules.csv",
    output:
        "bench/openconf-h2h/conf-fix/summary.csv",
        "bench/openconf-h2h/conf-fix/stats.csv",
        "bench/openconf-h2h/conf-fix/stats-develop.csv",
    shell:
        """
        set -euo pipefail
        OPENCONF_H2H_CREST=0 OPENCONF_H2H_BASELINE=92bc5805b476b529c90ab3b2c1db4b48c97ab93a \
            bash scripts/openconf_h2h/enter_bench.sh paired --tree conf-fix \
            --baseline /work/openconf-h2h/baseline
        OPENCONF_H2H_SKIP_BUILD=1 bash scripts/openconf_h2h/enter_bench.sh paired-score \
            --tree conf-fix --baseline /work/openconf-h2h/baseline \
            --results bench/openconf-h2h/conf-fix
        """


# The same three arms with the stereocentre hold on, develop
