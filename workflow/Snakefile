# Elja Lennard-Jones probe.
# Launch with the profile, which caps concurrency:
#   snakemake --profile profiles/elja --config sizes=75 seeds=0
# An empty config submits nothing. The build script refuses to write
# the cargo target onto /users/home.

configfile: "config/elja_lj.yaml"


SIZES = [s.strip() for s in str(config.get("sizes", "")).split(",") if s.strip()]
SEEDS = [s.strip() for s in str(config.get("seeds", "")).split(",") if s.strip()]


rule all:
    input:
        expand("results/elja/n{n}/seed{seed}.log", n=SIZES, seed=SEEDS),


rule lj_seed:
    output:
        "results/elja/n{n}/seed{seed}.log",
    params:
        budget=config["budget"],
        arm=config["arm"],
    resources:
        runtime=480,
        mem_mb=16000,
        cpus_per_task=4,
    shell:
        """
        set -euo pipefail
        export LJ_ROOT="$PWD"
        bash scripts/elja_build_lj.sh
        source scripts/elja_scratch.sh
        elja_enter_scratch
        trap elja_leave_scratch EXIT
        SEED_OFFSET={wildcards.seed} \
          "$LJ_ROOT/target/release/examples/lj_cluster_search" \
          {wildcards.n} {params.budget} 1 {params.arm} \
          > "$ELJA_SCRATCH/seed.log" 2>&1
        elja_publish "$ELJA_SCRATCH/seed.log" {output}
        """


# GMIN against the paper preset at the paper force-call budgets.
# Not part of `rule all`. Run it by name:
#   snakemake -s workflow/Snakefile gmin_h2h
rule gmin_h2h:
    output:
        "bench/gmin-h2h/results.csv",
    shell:
        """
        set -euo pipefail
        bash scripts/gmin_h2h/enter_bench.sh
        """


# Lennard-Jones head-to-head against the published bonobo initialiser.
# Not part of `rule all`. Run it by name:
#   snakemake -s workflow/Snakefile lj_bonobo_h2h
rule lj_bonobo_h2h:
    output:
        "bench/lj-bonobo-h2h/summary.tsv",
        "bench/lj-bonobo-h2h/seeds.tsv",
    shell:
        """
        set -euo pipefail
        bash scripts/lj_bonobo_h2h/enter_bench.sh
        """


# GFN2-xTB (H2O)20 anneal versus CREST. Not part of `rule all`.
# Write bench/water-h2o20-goat/reference.csv with
# scripts/h2o20_goat_reference.sh before this rule. GOAT rows are
# skipped unless `orca` is on PATH.
#   snakemake -s workflow/Snakefile water_h2o20_goat
rule water_h2o20_goat:
    input:
        "bench/water-h2o20-goat/reference.csv",
    output:
        "bench/water-h2o20-goat/results.csv",
    shell:
        """
        set -euo pipefail
        bash scripts/h2o20_goat_campaign.sh
        """


# Paper minima dumps, xyz dumps, and raw runs listed in data/hf-files.csv.
# Dataset: rgoswami/anneal-paper-data (repo type dataset).
# Not part of `rule all`. Scripts that read those files call the same
# program before they open them.
#   snakemake -s workflow/Snakefile fetch_paper_data
rule fetch_paper_data:
    output:
        "build/hf-fetch.ok",
    shell:
        """
        set -euo pipefail
        python3 scripts/data/fetch_data.py
        mkdir -p build
        : > build/hf-fetch.ok
        """


# TIP4P (H2O)10, 15 and 20 on the paper preset. Not part of `rule all`.
#   snakemake -s workflow/Snakefile tip4p_rates
rule tip4p_rates:
    output:
        "bench/tip4p-water-rates/rates.csv",
    shell:
        """
        set -euo pipefail
        bash scripts/tip4p_rates/enter_bench.sh
        """
