# Stillinger-Weber silicon and Tersoff carbon, anneal against GMIN and ASE
# basin hopping: the third panel, twelve seeds, the paper budgets, serial
# on core 0. The "v2" arms are develop's build at 7da10659. Needs rgpot's
# covalent library and ASE (paths in the scripts). Not part of `rule all`.
#   snakemake -s workflow/Snakefile covalent_h2h
rule covalent_h2h:
    output:
        "bench/covalent-h2h/v3/seeds.csv",
        "bench/covalent-h2h/v3/results.csv",
    shell:
        """
        set -euo pipefail
        BENCH_OUT=v3 BEFORE_REV=7da10659 bash scripts/covalent_h2h/enter_bench.sh
        """


# GFN2-xTB Si10 and C10, anneal's general arm against CREST 3.0.2, twelve
# seeds, 1e5 calls, 3000 K electronic temperature. Needs xtb 6.7.1, CREST
# and rgpot's libxtb_engine.so (paths in the script). Not part of `rule all`.
# Rows and summaries are appended to bench/covalent-h2h/gfn2/rows.csv and
# summaries.csv; the output is a stamp under /work, because Snakemake
# deletes declared outputs before a job and would take the rows with it.
#   snakemake -s workflow/Snakefile covalent_gfn2_crest
rule covalent_gfn2_crest:
    output:
        touch("/work/covalent-h2h/gfn2/stamps/panel.stamp"),
    shell:
        """
        set -euo pipefail
        bash scripts/covalent_h2h/gfn2_enter_bench.sh
        """


# CREST's Si10 seeds 2004-2011, bringing the arm to the twelve seeds of the
# anneal arm. Same stamp rule as above; GFN2_CORE picks the core.
#   snakemake -s workflow/Snakefile covalent_gfn2_crest_si10_n12
rule covalent_gfn2_crest_si10_n12:
    output:
        touch("/work/covalent-h2h/gfn2/stamps/si10-crest-n12.stamp"),
    shell:
        """
        set -euo pipefail
        GFN2_CODES=crest bash scripts/covalent_h2h/gfn2_enter_bench.sh \
          --systems si10 --crest-seeds 2004 2005 2006 2007 2008 2009 2010 2011
        """


