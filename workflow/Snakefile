# Medians of the whole-walk restart trials. Reads the twelve-seed anneal
# rows and the restart runs; it does not launch a search. Not part of
# `rule all`.
#   snakemake -s workflow/Snakefile sc_restart_summary
rule sc_restart_summary:
    input:
        "bench/metal-cluster-h2h/sc-n12/seeds.csv",
        "bench/metal-cluster-h2h/sc-restart/rows.csv",
    output:
        "bench/metal-cluster-h2h/sc-restart/summary.csv",
    shell:
        """
        set -euo pipefail
        python3 scripts/metal_h2h/summarise_sc_restart.py
        """


