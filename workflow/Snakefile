        """
        set -euo pipefail
        OPENCONF_H2H_CREST=0 OPENCONF_H2H_BASELINE=7d8fa6ea6ec819a197b5390d87abab28423fd967 \
            bash scripts/openconf_h2h/enter_bench.sh paired --tree conf-fix3 \
            --baseline /work/openconf-h2h/baseline
        OPENCONF_H2H_SKIP_BUILD=1 bash scripts/openconf_h2h/enter_bench.sh paired \
            --tree conf-fix3-xld24 --baseline /work/openconf-h2h/baseline \
            --molecules xld --seeds $(seq 2000 2023)
        OPENCONF_H2H_SKIP_BUILD=1 bash scripts/openconf_h2h/enter_bench.sh paired-score \
            --tree conf-fix3 --baseline /work/openconf-h2h/baseline \
            --results bench/openconf-h2h/conf-fix3
        OPENCONF_H2H_SKIP_BUILD=1 bash scripts/openconf_h2h/enter_bench.sh paired-score \
