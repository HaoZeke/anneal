+    /// Quiet counts from the chain, in hops. A zero pair does not wipe a
+    /// record already noted: a side ledger starts at zero and must not
+    /// shorten the walk the main chain is on.
+    pub fn note_quiet(&mut self, quiet: usize, longest_quiet: usize) {
+        if quiet == 0 && longest_quiet == 0 && (self.quiet > 0 || self.longest_quiet > 0) {
+            return;
+        }
+        self.quiet = quiet;
+        self.longest_quiet = longest_quiet;
+    }
+
+    /// The walk stays at least one block. Once the chain has survived a
+    /// longer quiet stretch, the next walk runs that long, and it ends
+    /// sooner only when the current quiet has passed that record.
+    fn walk_spent(&self) -> bool {
+        if self.hops_in_block < self.block {
+            return false;
+        }
+        let survived = self.longest_quiet;
+        if survived > self.block && self.quiet > survived {
+            return true;
+        }
+        self.hops_in_block >= self.block.max(survived)
+    }
