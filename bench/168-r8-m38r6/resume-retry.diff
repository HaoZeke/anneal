+    #[test]
+    fn only_a_restraint_block_the_hold_handed_back_fails_as_a_retry() {
+        let mut portfolio = SurfacePortfolio::with_block(&[TwoPhase::diameter(2.0, 1.0)], 3, 1);
+        portfolio.begin(true);
+        portfolio.held = Some(0);
+        portfolio.observe(false, -3.0, -3.0);
+        portfolio.begin(true);
+        portfolio.held = Some(1);
+        portfolio.observe(false, -2.0, -3.0);
+        portfolio.begin(true);
+        assert!(portfolio.take_restraint_block_failed());
+        assert!(
+            !portfolio.take_failed_retry(),
+            "a first failure is not a retry"
+        );
+        portfolio.hold_plain();
+        let mut retried = false;
+        for _ in 0..20 {
+            portfolio.observe(false, -2.5, -3.0);
+            portfolio.begin(true);
+            if portfolio.take_restraint_block_failed() {
+                retried = portfolio.take_failed_retry();
+                break;
+            }
+        }
+        assert!(
+            retried,
+            "the failed block the hold handed back was not a retry"
+        );
+        assert!(!portfolio.take_failed_retry(), "a retry is reported once");
+    }
