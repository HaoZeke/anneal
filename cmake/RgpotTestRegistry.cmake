# Reads CppCore/tests/registry.txt, which lists every test meson and CMake
# register with the features that enable it and its options (see the
# comments there).
#
#   rgpot_test_enabled(NAME OUT)
#       OUT is true when NAME's gate holds here and NAME is not meson-only.
#   rgpot_registry_tests(KIND OUT)
#       The enabled entries of one kind.
#   rgpot_registry_field(NAME FIELD OUT)
#       An entry's args (its positional arguments) or unfused flag.
#   rgpot_add_test(NAME COMMAND command... [ENVIRONMENT VAR=VALUE...])
#       Registers an enabled entry with its timeout, suite, working
#       directory, environment, serial and should_fail settings, and stops
#       the configuration for any other name.
#   rgpot_registry_feature_args(OUT)
#       FEATURE=0|1 for each feature the registry names, the arguments
#       check_test_registry.py takes.
#
# RGPOT_TEST_FEATURE_<feature> holds each feature's value in this
# configuration and has to be set before the functions run.

# A test name may hold spaces ("CuH2 Utils Test"). The functions below keep
# the policies set here.
if(POLICY CMP0110)
  cmake_policy(SET CMP0110 NEW)
endif()

get_filename_component(RGPOT_TEST_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(RGPOT_TEST_REGISTRY "${RGPOT_TEST_ROOT}/CppCore/tests/registry.txt")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS
                                       "${RGPOT_TEST_REGISTRY}")

set(RGPOT_REGISTRY_ENTRIES)
set(RGPOT_REGISTRY_FEATURES)
file(STRINGS "${RGPOT_TEST_REGISTRY}" _rgpot_rt_lines)
foreach(_line IN LISTS _rgpot_rt_lines)
  string(STRIP "${_line}" _line)
  if(_line STREQUAL "" OR _line MATCHES "^[#@]")
    continue()
  endif()
  if(NOT _line MATCHES "^([^|]*)\\|([^|]*)\\|([^|]*)\\|([^|]*)$")
    message(FATAL_ERROR "${RGPOT_TEST_REGISTRY}: cannot read ${_line}")
  endif()
  string(STRIP "${CMAKE_MATCH_1}" _name)
  set(_gate "${CMAKE_MATCH_2}")
  set(_spec "${CMAKE_MATCH_3}")
  string(STRIP "${CMAKE_MATCH_4}" _reason)
  string(MAKE_C_IDENTIFIER "${_name}" _id)
  if(DEFINED _rgpot_rt_${_id}_kind)
    message(FATAL_ERROR
      "${RGPOT_TEST_REGISTRY}: ${_name} shares the CMake variable name "
      "${_id} with another entry")
  endif()
  separate_arguments(_clauses UNIX_COMMAND "${_gate}")
  separate_arguments(_words UNIX_COMMAND "${_spec}")
  list(POP_FRONT _words _kind)
  set(_args)
  set(_timeout 30)
  set(_suite)
  set(_workdir)
  if(_kind STREQUAL "unit")
    set(_workdir .)
  endif()
  set(_env)
  set(_serial FALSE)
  set(_should_fail FALSE)
  set(_unfused FALSE)
  foreach(_word IN LISTS _words)
    if(_word MATCHES "^timeout=(.+)$")
      set(_timeout "${CMAKE_MATCH_1}")
    elseif(_word MATCHES "^suite=(.+)$")
      set(_suite "${CMAKE_MATCH_1}")
    elseif(_word MATCHES "^workdir=(.+)$")
      set(_workdir "${CMAKE_MATCH_1}")
    elseif(_word MATCHES "^env=(.+)$")
      list(APPEND _env "${CMAKE_MATCH_1}")
    elseif(_word STREQUAL "serial")
      set(_serial TRUE)
    elseif(_word STREQUAL "should_fail")
      set(_should_fail TRUE)
    elseif(_word STREQUAL "fp_contract=off")
      set(_unfused TRUE)
    else()
      list(APPEND _args "${_word}")
    endif()
  endforeach()
  foreach(_clause IN LISTS _clauses)
    string(REPLACE "," ";" _alternatives "${_clause}")
    list(APPEND RGPOT_REGISTRY_FEATURES ${_alternatives})
  endforeach()
  foreach(_field kind clauses args timeout suite workdir env serial should_fail
                 unfused reason)
    set(_rgpot_rt_${_id}_${_field} "${_${_field}}")
  endforeach()
  list(APPEND RGPOT_REGISTRY_ENTRIES "${_name}")
endforeach()
list(REMOVE_DUPLICATES RGPOT_REGISTRY_FEATURES)
list(REMOVE_ITEM RGPOT_REGISTRY_FEATURES probe)

function(rgpot_test_feature feature out)
  if(NOT DEFINED RGPOT_TEST_FEATURE_${feature})
    message(FATAL_ERROR
      "${RGPOT_TEST_REGISTRY} names the feature ${feature}, which has no "
      "RGPOT_TEST_FEATURE_${feature} in CMake")
  endif()
  if(RGPOT_TEST_FEATURE_${feature})
    set(${out} TRUE PARENT_SCOPE)
  else()
    set(${out} FALSE PARENT_SCOPE)
  endif()
endfunction()

function(rgpot_test_enabled name out)
  string(MAKE_C_IDENTIFIER "${name}" id)
  if(NOT DEFINED _rgpot_rt_${id}_kind)
    message(FATAL_ERROR "${name} has no entry in ${RGPOT_TEST_REGISTRY}")
  endif()
  set(enabled FALSE)
  if(_rgpot_rt_${id}_reason STREQUAL "")
    set(enabled TRUE)
    foreach(clause IN LISTS _rgpot_rt_${id}_clauses)
      string(REPLACE "," ";" alternatives "${clause}")
      set(any FALSE)
      foreach(feature IN LISTS alternatives)
        rgpot_test_feature("${feature}" holds)
        if(holds)
          set(any TRUE)
        endif()
      endforeach()
      if(NOT any)
        set(enabled FALSE)
      endif()
    endforeach()
  endif()
  set(${out} ${enabled} PARENT_SCOPE)
endfunction()

function(rgpot_registry_tests kind out)
  set(names)
  foreach(name IN LISTS RGPOT_REGISTRY_ENTRIES)
    string(MAKE_C_IDENTIFIER "${name}" id)
    if(_rgpot_rt_${id}_kind STREQUAL kind)
      rgpot_test_enabled("${name}" enabled)
      if(enabled)
        list(APPEND names "${name}")
      endif()
    endif()
  endforeach()
  set(${out} "${names}" PARENT_SCOPE)
endfunction()

function(rgpot_registry_field name field out)
  string(MAKE_C_IDENTIFIER "${name}" id)
  if(NOT DEFINED _rgpot_rt_${id}_kind)
    message(FATAL_ERROR "${name} has no entry in ${RGPOT_TEST_REGISTRY}")
  endif()
  set(${out} "${_rgpot_rt_${id}_${field}}" PARENT_SCOPE)
endfunction()

function(rgpot_add_test name)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "COMMAND;ENVIRONMENT")
  rgpot_test_enabled("${name}" enabled)
  if(NOT enabled)
    message(FATAL_ERROR
      "${name} is meson-only, or its gate in ${RGPOT_TEST_REGISTRY} does "
      "not hold in this configuration")
  endif()
  string(MAKE_C_IDENTIFIER "${name}" id)
  add_test(NAME "${name}" COMMAND ${arg_COMMAND})
  set(workdir "${_rgpot_rt_${id}_workdir}")
  if(workdir STREQUAL "")
    set(workdir "${CMAKE_CURRENT_BINARY_DIR}")
  elseif(workdir STREQUAL ".")
    set(workdir "${RGPOT_TEST_ROOT}")
  else()
    set(workdir "${RGPOT_TEST_ROOT}/${workdir}")
  endif()
  set_tests_properties("${name}" PROPERTIES
    TIMEOUT "${_rgpot_rt_${id}_timeout}"
    WORKING_DIRECTORY "${workdir}")
  if(NOT _rgpot_rt_${id}_suite STREQUAL "")
    set_tests_properties("${name}" PROPERTIES
      LABELS "${_rgpot_rt_${id}_suite}")
  endif()
  set(environment ${_rgpot_rt_${id}_env} ${arg_ENVIRONMENT})
  if(environment)
    set_tests_properties("${name}" PROPERTIES ENVIRONMENT "${environment}")
  endif()
  if(_rgpot_rt_${id}_serial)
    set_tests_properties("${name}" PROPERTIES RUN_SERIAL TRUE)
  endif()
  if(_rgpot_rt_${id}_should_fail)
    set_tests_properties("${name}" PROPERTIES WILL_FAIL TRUE)
  endif()
endfunction()

function(rgpot_registry_feature_args out)
  set(args)
  foreach(feature IN LISTS RGPOT_REGISTRY_FEATURES)
    rgpot_test_feature("${feature}" holds)
    if(holds)
      list(APPEND args "${feature}=1")
    else()
      list(APPEND args "${feature}=0")
    endif()
  endforeach()
  set(${out} "${args}" PARENT_SCOPE)
endfunction()
