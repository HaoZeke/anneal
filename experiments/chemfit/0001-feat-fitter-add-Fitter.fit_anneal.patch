+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Any
+
+import numpy as np
+import pytest
+
+from chemfit.fitter import ANNEAL_METHODS, Fitter
+
+if TYPE_CHECKING:
+    from collections.abc import Callable
+
+anneal = pytest.importorskip("anneal")
+
+N_ATOMS = 13
+
+
+def lj_energy(params: dict[str, Any]) -> float:
+    p = np.asarray(params["positions"], dtype=np.float64).reshape(-1, 3)
+    r = np.linalg.norm(p[:, None] - p[None], axis=-1)[np.triu_indices(len(p), 1)]
+    with np.errstate(divide="ignore", invalid="ignore", over="ignore"):
+        energy = float(np.sum(4.0 * (r**-12 - r**-6)))
+    return energy if np.isfinite(energy) else 1e10
+
+
+class Recorder:
+    def __init__(self, func: Callable[[dict[str, Any]], float]) -> None:
+        """Wrap ``func`` and keep a copy of every parameter set it sees."""
+        self.func = func
+        self.seen: list[dict[str, Any]] = []
+
+    def __call__(self, params: dict[str, Any]) -> float:
+        self.seen.append({k: np.array(v, copy=True) for k, v in params.items()})
+        return self.func(params)
+
+
+def positions_fitter(
+    objective: Callable[[dict[str, Any]], float],
+) -> tuple[Fitter, np.ndarray]:
+    initial = np.random.default_rng(3).uniform(-1.6, 1.6, (N_ATOMS, 3))
+    fitter = Fitter(
+        objective,
+        initial_params={"positions": initial},
+        bounds={"positions": (-3.0, 3.0)},
+        value_bad_params=1e10,
+    )
+    return fitter, initial
+
+
+@pytest.mark.parametrize("method", ANNEAL_METHODS)
+def test_fit_anneal_keeps_positions_in_bounds_and_starts_at_initial_params(method: str):
+    objective = Recorder(lj_energy)
+    fitter, initial = positions_fitter(objective)
+    best = fitter.fit_anneal(budget=300, method=method, seed=1)
+
+    positions = np.array([seen["positions"] for seen in objective.seen])
+    assert positions.shape[1:] == (N_ATOMS, 3)
+    assert np.all(positions >= -3.0)
+    assert np.all(positions <= 3.0)
+    assert np.allclose(positions[0], initial)
+    assert len(objective.seen) <= 300
+    assert lj_energy(best) <= lj_energy({"positions": initial})
+    assert lj_energy(best) == min(lj_energy(seen) for seen in objective.seen)
+
+
+@pytest.mark.parametrize("method", ["boltzmann", "fast", "gsa"])
+def test_fit_anneal_classical_methods_spend_exactly_the_budget(method: str):
+    objective = Recorder(lj_energy)
+    fitter, _ = positions_fitter(objective)
+    steps: list[int] = []
+    fitter.register_callback(lambda step, _ctxs: steps.append(step), n_steps=100)
+    fitter.fit_anneal(budget=1037, method=method, seed=2)
+    assert len(objective.seen) == 1037
+    assert steps == [100 * k for k in range(1, 11)] + [1037]
+
+
+def test_fit_anneal_mixes_scalar_and_array_leaves():
+    target = np.array([[0.5, -0.25], [1.0, 2.0]])
+
+    def loss(params: dict[str, Any]) -> float:
+        return float(
+            np.sum((params["matrix"] - target) ** 2)
+            + (params["nested"]["scale"] - 1.5) ** 2
+        )
+
+    fitter = Fitter(
+        loss,
+        initial_params={"matrix": np.zeros((2, 2)), "nested": {"scale": 0.0}},
+        bounds={"matrix": (-3.0, 3.0), "nested": {"scale": (0.0, 2.0)}},
+    )
+    best = fitter.fit_anneal(budget=600, method="portfolio", seed=0)
+    assert isinstance(best["nested"]["scale"], float)
+    assert best["matrix"].shape == (2, 2)
+    assert loss(best) < loss({"matrix": np.zeros((2, 2)), "nested": {"scale": 0.0}})
+
+
+@pytest.mark.parametrize("method", ANNEAL_METHODS)
+def test_fit_anneal_takes_array_bounds_per_element(method: str):
+    objective = Recorder(lambda p: float(np.sum(p["x"] ** 2)))
+    fitter = Fitter(
+        objective,
+        initial_params={"x": np.array([0.5, 0.5])},
+        bounds={"x": (np.array([0.1, -1.0]), np.array([1.0, 1.0]))},
+    )
+    fitter.fit_anneal(budget=200, method=method, seed=0)
+    points = np.array([seen["x"] for seen in objective.seen])
+    assert np.all(points[:, 0] >= 0.1)
+    assert np.all(points[:, 1] >= -1.0)
+    assert np.all(points <= 1.0)
+
+
+@pytest.mark.parametrize(
+    ("bounds", "message"),
+    [
+        (None, "finite bounds"),
+        ({"x": (None, 1.0)}, "finite bounds"),
+        ({"x": (-np.inf, 1.0)}, "finite with lower < upper"),
+        ({"x": (2.0, 3.0)}, "outside its bounds"),
+    ],
+)
+def test_fit_anneal_rejects_boxes_it_cannot_search(
+    bounds: dict[str, tuple[float | None, float]] | None, message: str
+):
+    fitter = Fitter(lambda p: p["x"] ** 2, initial_params={"x": 1.0}, bounds=bounds)
+    with pytest.raises(ValueError, match=message):
+        fitter.fit_anneal(budget=10)
+
+
+def test_fit_anneal_rejects_unknown_method_and_empty_budget():
+    fitter = Fitter(
+        lambda p: p["x"] ** 2, initial_params={"x": 1.0}, bounds={"x": (-2.0, 2.0)}
+    )
+    with pytest.raises(ValueError, match="method"):
+        fitter.fit_anneal(budget=10, method="tabu")
+    with pytest.raises(ValueError, match="budget"):
+        fitter.fit_anneal(budget=0)
+
+
+def test_fit_anneal_reraises_objective_exceptions_and_stops_evaluating():
+    calls: list[float] = []
+
+    def fails_on_fifth(params: dict[str, float]) -> float:
+        calls.append(params["x"])
+        if len(calls) == 5:
+            msg = "external program failed"
+            raise RuntimeError(msg)
+        return params["x"] ** 2
+
+    fitter = Fitter(
+        fails_on_fifth,
+        initial_params={"x": 1.0},
+        bounds={"x": (-2.0, 2.0)},
+        log_exceptions=False,
+    )
+    with pytest.raises(RuntimeError, match="external program failed"):
+        fitter.fit_anneal(budget=200, method="boltzmann")
+    assert len(calls) == 5
+
+
+def test_fit_anneal_swallowed_exceptions_become_penalties():
+    def flaky(params: dict[str, float]) -> float:
+        if params["x"] > 1.0:
+            msg = "unphysical"
+            raise ValueError(msg)
+        return (params["x"] - 0.5) ** 2
+
+    fitter = Fitter(
+        flaky,
+        initial_params={"x": 0.0},
+        bounds={"x": (-2.0, 2.0)},
+        swallow_exceptions=True,
+        log_exceptions=False,
+    )
+    best = fitter.fit_anneal(budget=300, method="portfolio")
+    assert best["x"] == pytest.approx(0.5, abs=0.05)
+
+
+def test_fit_anneal_uses_a_supplied_gradient():
+    grads: list[float] = []
+
+    def gradient(params: dict[str, float]) -> dict[str, float]:
+        grads.append(params["x"])
+        return {"x": 2.0 * (params["x"] - 0.3)}
+
+    fitter = Fitter(
+        lambda p: (p["x"] - 0.3) ** 2,
+        initial_params={"x": -1.5},
+        bounds={"x": (-2.0, 2.0)},
+    )
+    best = fitter.fit_anneal(budget=200, method="portfolio", gradient=gradient)
+    assert grads
+    assert best["x"] == pytest.approx(0.3, abs=1e-3)
