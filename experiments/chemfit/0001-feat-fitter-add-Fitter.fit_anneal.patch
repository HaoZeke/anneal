             raise
 
+    def fit_anneal(
+        self,
+        budget: int,
+        method: str = "portfolio",
+        seed: int = 0,
+        preset: object | None = None,
+        steps_per_epoch: int = 100,
+        gradient: Callable[[ParametersT], Mapping[str, Any]] | None = None,
+        contexts: list[FitterEvaluateContext] | None = None,
+    ) -> ParametersT:
+        """
+        Optimize parameters with the anneal library.
+
+        The search starts at ``initial_params`` and stays inside ``bounds``,
+        which must give a finite ``(lower, upper)`` pair for every parameter
+        leaf; array leaves such as an ``(n_atoms, 3)`` positions array take
+        scalar or array bounds. Every candidate is evaluated through
+        :meth:`evaluate`, :meth:`step` is called after each evaluation, and the
+        objective is evaluated at most ``budget`` times. The best evaluated
+        parameters are returned.
+
+        Args:
+            budget: Maximum number of objective evaluations.
+            method: ``"portfolio"`` (``anneal.global_optimize``, the
+                general-purpose driver), ``"boltzmann"``, ``"fast"`` or
+                ``"gsa"`` (classical simulated annealing, ``anneal.run``),
+                or ``"gpmd"`` (gap-proportional Metropolis descent).
+            seed: Random seed forwarded to anneal.
+            preset: Optional ``anneal.Boltzmann``, ``anneal.Fast`` or
+                ``anneal.Gsa`` for the classical methods. Steps are in units
+                of the box width (anneal searches the unit cube); the
+                temperature is in loss units.
+            steps_per_epoch: Proposals per temperature for the classical
+                methods.
+            gradient: Optional callable returning the gradient of the loss
+                as a mapping with the structure of ``initial_params``; used by
+                ``"portfolio"`` and ``"gpmd"``. Gradient calls do not count
+                against ``budget`` but anneal charges them as work units.
+            contexts: Optional single-element list with the fitter context to
+                reuse.
+
+        Returns:
+            Dictionary of the best evaluated parameter values.
+
+        Raises:
+            ImportError: If anneal is missing or predates bounded presets
+                with ``x0`` and ``max_evals``.
+            ValueError: For an unknown method, a non-positive budget, a
+                missing or infinite bound, or an initial value outside its
+                bounds.
+
+        """
+
+        anneal = _import_anneal()
+
+        if method not in ANNEAL_METHODS:
+            msg = f"method must be one of {ANNEAL_METHODS}, got {method!r}"
+            raise ValueError(msg)
+        if budget < 1:
+            msg = "budget must be at least 1"
+            raise ValueError(msg)
+
+        box = _AnnealBox(self.initial_parameters, self.bounds)
+        unit_x0 = box.to_unit(box.x0)
+
+        evaluations = 0
+        failure: list[Exception] = []
+
+        def loss(unit: npt.NDArray) -> float:
+            nonlocal evaluations
+            if failure or evaluations >= budget:
+                return math.inf
+            evaluations += 1
+            parameters = cast("ParametersT", box.parameters(unit))
+            try:
+                value = self.evaluate(parameters)
+            except Exception as exc:
+                # Keep ChemFit's exception policy: stop evaluating, let anneal
+                # return, then re-raise below.
+                failure.append(exc)
+                return math.inf
+            self.step()
+            assert isinstance(value, float)
+            return value
+
+        unit_gradient: Callable[[npt.NDArray], npt.NDArray] | None = None
+        if gradient is not None:
+            user_gradient = gradient
+
+            def gradient_in_unit_cube(unit: npt.NDArray) -> npt.NDArray:
+                parameters = cast("ParametersT", box.parameters(unit))
+                return box.unit_gradient(user_gradient(parameters))
+
+            unit_gradient = gradient_in_unit_cube
+
+        self.init(contexts=contexts)
+        try:
+            _run_anneal_driver(
+                anneal,
+                method,
+                loss,
+                unit_x0,
+                budget=budget,
+                seed=seed,
+                preset=preset,
+                steps_per_epoch=steps_per_epoch,
+                gradient=unit_gradient,
+            )
+            if failure:
+                raise failure[0]
+            if evaluations == 0:
+                msg = "anneal made no evaluation within the budget"
+                raise RuntimeError(msg)
+            return self.finish()
+        except BaseException as exception:
+            try:
+                self._close_schedule()
+            except BaseException as cleanup_exception:
+                if hasattr(exception, "add_note"):
+                    exception.add_note(
+                        f"Schedule cleanup failed: {cleanup_exception!r}"
+                    )
+            raise
+
     def fit_scipy(
         self,
         method: str = "L-BFGS-B",
