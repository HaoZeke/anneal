 CallbackT = Callable[[int, list[FitterEvaluateContext]], None]
 
+ANNEAL_METHODS = ("portfolio", "boltzmann", "fast", "gsa", "gpmd")
+
+
+def _import_anneal() -> Any:
+    """Return the anneal module, refusing releases without bounded presets."""
+
+    try:
+        import anneal  # noqa: PLC0415
+    except ImportError as exc:
+        msg = "fit_anneal requires the anneal package (pip install anneal)"
+        raise ImportError(msg) from exc
+    if "max_evals" not in inspect.signature(anneal.run).parameters:
+        msg = (
+            "fit_anneal requires an anneal release whose run() keeps every "
+            "evaluation inside the box and accepts x0 and max_evals"
+        )
+        raise ImportError(msg)
+    return anneal
+
+
+def _run_anneal_driver(
+    anneal: Any,
+    method: str,
+    loss: Callable[[npt.NDArray], float],
+    unit_x0: npt.NDArray,
+    *,
+    budget: int,
+    seed: int,
+    preset: object | None,
+    steps_per_epoch: int,
+    gradient: Callable[[npt.NDArray], npt.NDArray] | None,
+) -> None:
+    """Run one anneal driver on the unit cube from ``unit_x0``."""
+
+    low, high = np.zeros(unit_x0.size), np.ones(unit_x0.size)
+    if method == "portfolio":
+        anneal.global_optimize(
+            loss, low, high, budget=budget, seed=seed, grad_fn=gradient, x0=unit_x0
+        )
+        return
+    if method == "gpmd":
+        anneal.gpmd_optimize(
+            loss, low, high, budget=budget, seed=seed, grad_fn=gradient, x0=unit_x0
+        )
+        return
+    if preset is None:
+        preset = {
+            "boltzmann": anneal.Boltzmann(t_init=1.0, sigma=0.02),
+            "fast": anneal.Fast(t_init=1.0, gamma=0.01),
+            "gsa": anneal.Gsa(t_init=0.05),
+        }[method]
+    anneal.run(
+        loss,
+        low,
+        high,
+        preset,
+        n_epochs=max(1, math.ceil((budget - 1) / steps_per_epoch)),
+        steps_per_epoch=steps_per_epoch,
+        seed=seed,
+        x0=unit_x0,
+        max_evals=budget,
+    )
+
+
+class _AnnealBox:
+    """
+    The fitter's parameters as one flat vector inside a finite box.
+
+    Scalar and array leaves are flattened in C order. Each leaf needs a
+    ``(lower, upper)`` bound; an array leaf takes scalars or arrays that
+    broadcast to its shape. Points are passed to anneal in the unit cube, so
+    step sizes do not depend on the units of the parameters.
+    """
+
+    def __init__(self, initial: Mapping[str, Any], bounds: Mapping[str, object]):
+        flat_initial = flatten_dict(dict(initial))
+        flat_bounds = flatten_dict(dict(bounds))
+        self.keys = list(flat_initial)
+        self.shapes: list[tuple[tuple[int, ...], bool]] = []
+        starts, lows, highs = [], [], []
+        for key in self.keys:
+            leaf = flat_initial[key]
+            value = np.asarray(leaf, dtype=np.float64)
+            bound = flat_bounds.get(key)
+            if bound is None or len(bound) != 2 or bound[0] is None or bound[1] is None:
+                msg = (
+                    f"fit_anneal needs finite bounds (lower, upper) for {key!r}; "
+                    "anneal searches inside a box"
+                )
+                raise ValueError(msg)
+            lower = np.broadcast_to(np.asarray(bound[0], dtype=np.float64), value.shape)
+            upper = np.broadcast_to(np.asarray(bound[1], dtype=np.float64), value.shape)
+            finite = np.isfinite(lower).all() and np.isfinite(upper).all()
+            if not finite or np.any(lower >= upper):
+                msg = f"bounds for {key!r} must be finite with lower < upper"
+                raise ValueError(msg)
+            if not np.isfinite(value).all() or np.any(
+                (value < lower) | (value > upper)
+            ):
+                msg = f"initial value of {key!r} lies outside its bounds"
+                raise ValueError(msg)
+            self.shapes.append((value.shape, isinstance(leaf, Real)))
+            starts.append(value.ravel())
+            lows.append(lower.ravel())
+            highs.append(upper.ravel())
+        self.low = np.concatenate(lows)
+        self.width = np.concatenate(highs) - self.low
+        self.x0 = np.concatenate(starts)
+
+    def to_unit(self, x: npt.NDArray) -> npt.NDArray:
+        return np.clip((x - self.low) / self.width, 0.0, 1.0)
+
+    def parameters(self, unit: npt.NDArray) -> dict[str, Any]:
+        x = self.low + self.width * np.clip(unit, 0.0, 1.0)
+        out: dict[str, Any] = {}
+        offset = 0
+        for key, (shape, scalar) in zip(self.keys, self.shapes, strict=True):
+            size = math.prod(shape)
+            chunk = np.array(x[offset : offset + size], dtype=np.float64)
+            offset += size
+            out[key] = float(chunk[0]) if scalar else chunk.reshape(shape)
+        return unflatten_dict(out, dict_factory=dict[str, Any])
+
+    def unit_gradient(self, gradient: Mapping[str, Any]) -> npt.NDArray:
+        flat = flatten_dict(dict(gradient))
+        parts = [
+            np.broadcast_to(np.asarray(flat[key], dtype=np.float64), shape).ravel()
+            for key, (shape, _) in zip(self.keys, self.shapes, strict=True)
+        ]
+        return np.concatenate(parts) * self.width
+
 
