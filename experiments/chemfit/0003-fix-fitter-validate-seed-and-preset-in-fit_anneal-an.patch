diff --git a/tests/test_fit_anneal.py b/tests/test_fit_anneal.py
index 07a43f7..2828cb6 100644
--- a/tests/test_fit_anneal.py
+++ b/tests/test_fit_anneal.py
@@ -381,3 +381,31 @@ def test_fit_anneal_names_the_anneal_floor(monkeypatch: pytest.MonkeyPatch):
     )
     with pytest.raises(ImportError, match=r"anneal >= 0\.10\.0.*found anneal"):
         fitter.fit_anneal(budget=10)
+
+
+@pytest.mark.parametrize("seed", [None, -1, 1.5, True, 2**64])
+def test_fit_anneal_names_seed_in_seed_errors(seed: object):
+    fitter = Fitter(
+        lambda p: (p["x"] - 0.3) ** 2, initial_params={"x": 1.5}, bounds={"x": (-2, 2)}
+    )
+    with pytest.raises(ValueError, match="seed"):
+        fitter.fit_anneal(budget=10, seed=seed)  # type: ignore[arg-type]
+
+
+def test_fit_anneal_restarts_past_the_largest_seed():
+    recorder = Recorder(lambda p: (p["x"] - 0.3) ** 2)
+    fitter = Fitter(recorder, initial_params={"x": 1.5}, bounds={"x": (-2.0, 2.0)})
+    fitter.fit_anneal(budget=300, seed=2**64 - 1)
+    assert len(recorder.seen) == 300
+
+
+@pytest.mark.parametrize(
+    ("method", "preset"),
+    [("boltzmann", "Gsa"), ("gsa", "Boltzmann"), ("fast", "Boltzmann")],
+)
+def test_fit_anneal_rejects_a_preset_of_another_method(method: str, preset: str):
+    fitter = Fitter(
+        lambda p: (p["x"] - 0.3) ** 2, initial_params={"x": 1.5}, bounds={"x": (-2, 2)}
+    )
+    with pytest.raises(ValueError, match="does not match method"):
+        fitter.fit_anneal(budget=10, method=method, preset=getattr(anneal, preset)())
