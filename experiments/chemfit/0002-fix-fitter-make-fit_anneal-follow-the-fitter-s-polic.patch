+    if method not in ANNEAL_METHODS:
+        msg = f"method must be one of {ANNEAL_METHODS}, got {method!r}"
+        raise ValueError(msg)
+    whole_budget = _whole_number("budget", budget)
+    if method in _CLASSICAL_ANNEAL_METHODS:
+        if has_gradient:
+            msg = f"method {method!r} does not use a gradient"
+            raise ValueError(msg)
+    elif preset is not None:
+        msg = f"method {method!r} does not take a preset"
+        raise ValueError(msg)
+    elif steps_per_epoch is not None:
+        msg = f"method {method!r} does not take steps_per_epoch"
+        raise ValueError(msg)
