+class _AnnealSession:
+    """
+    One ``fit_anneal`` call: the fitter's loss on the unit cube and its ledger.
+
+    An exception that the fitter's policy re-raises is kept and ends the
+    anneal run through :class:`_StopAnneal`; ``fit_anneal`` raises it once the
+    driver has returned.
+    """
+
+    def __init__(self, fitter: Fitter[Any], box: _AnnealBox, budget: int):
+        self.fitter = fitter
+        self.box = box
+        self.budget = budget
+        self.evaluations = 0
+        self.failure: list[Exception] = []
+        self.best_value = math.inf
+        self.best_parameters: dict[str, Any] | None = None
+        self.best_unit: npt.NDArray | None = None
+
+    def loss(self, unit: npt.NDArray) -> float:
+        if self.failure or self.evaluations >= self.budget:
+            return math.inf
+        if self.best_unit is not None and np.array_equal(unit, self.best_unit):
+            return self.best_value
+        self.evaluations += 1
+        parameters = self.box.parameters(unit)
+        try:
+            value = self.fitter.evaluate(parameters)
+        except Exception as exc:
+            self.failure.append(exc)
+            raise _StopAnneal from None
+        assert isinstance(value, float)
+        if self.best_parameters is None or value < self.best_value:
+            self.best_value = value
+            self.best_parameters = parameters
+            self.best_unit = np.array(unit, dtype=np.float64)
+        try:
+            self.fitter.step()
+        except Exception as exc:
+            self.failure.append(exc)
+            raise _StopAnneal from None
+        return value
+
+    def unit_gradient(
+        self, gradient: Callable[[Any], Mapping[str, Any]]
+    ) -> Callable[[npt.NDArray], npt.NDArray]:
+        """``gradient`` on the unit cube, under the fitter's exception policy."""
+
+        def in_unit_cube(unit: npt.NDArray) -> npt.NDArray:
+            if self.failure:
+                return np.zeros(self.box.dim)
+            try:
+                return self.box.unit_gradient(gradient(self.box.parameters(unit)))
+            except Exception as exc:
+                if self.fitter.log_exceptions:
+                    logger.error(
+                        "Caught exception while evaluating the gradient.",
+                        exc_info=(type(exc), exc, exc.__traceback__),
+                    )
+                if not self.fitter.swallow_exceptions:
+                    self.failure.append(exc)
+                    raise _StopAnneal from None
+                return np.zeros(self.box.dim)
+
+        return in_unit_cube
+
+    def spend(
+        self,
+        anneal: Any,
+        method: str,
+        *,
+        seed: int,
+        preset: object | None,
+        steps_per_epoch: int,
+        gradient: Callable[[npt.NDArray], npt.NDArray] | None,
+    ) -> None:
+        """Run ``method`` until the budget is spent or an exception stops it."""
+
+        start, round_seed, cached_start = self.box.unit_x0, seed, 0
+        while True:
+            spent = self.evaluations
+            with contextlib.suppress(_StopAnneal):
+                _run_anneal_driver(
+                    anneal,
+                    method,
+                    self.loss,
+                    start,
+                    # A restart charges its cached start to anneal but not to
+                    # the fitter; loss() still stops at the budget.
+                    budget=self.budget - self.evaluations + cached_start,
+                    seed=round_seed,
+                    preset=preset,
+                    steps_per_epoch=steps_per_epoch,
+                    gradient=gradient,
+                )
+            if (
+                method in _CLASSICAL_ANNEAL_METHODS
+                or self.failure
+                or self.evaluations >= self.budget
+                or self.best_unit is None
+            ):
+                return
+            start, round_seed, cached_start = self.best_unit, round_seed + 1, 1
+            if self.evaluations == spent:
+                # Too few evaluations are left for the driver to start; a
+                # Boltzmann walk spends exactly what remains.
+                with contextlib.suppress(_StopAnneal):
+                    _run_anneal_driver(
+                        anneal,
+                        "boltzmann",
+                        self.loss,
+                        start,
+                        budget=self.budget - self.evaluations + cached_start,
+                        seed=round_seed,
+                        preset=None,
+                        steps_per_epoch=steps_per_epoch,
+                        gradient=None,
+                    )
+                return
 
 
